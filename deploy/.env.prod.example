# Lightsail 운영용. cp deploy/.env.prod.example deploy/.env 후 값을 채운다. 저장소에 올리지 않는다(.gitignore).

# ---- 주소 ----
# 이 도메인으로 HTTPS 인증서를 받는다. DNS A 레코드가 인스턴스 고정 IP 를 가리켜야 한다.
# 도메인이 없으면: ip-<고정IP를 -로>.sslip.io  (예: ip-3-35-1-2.sslip.io)
DOMAIN=

# ---- DB (compose 안의 MySQL) ----
DB_NAME=origin_check
DB_USERNAME=origin_check
# 무작위 값. 예: openssl rand -base64 24
DB_PASSWORD=
DB_ROOT_PASSWORD=

# ---- 인증 ----
# 32자 이상 무작위. 예: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_MIN=60
# 가입 허용 이메일(쉼표로 여러 개, '@회사도메인' 은 도메인 전체). 비우면 누구나 가입하므로 꼭 채운다
SIGNUP_ALLOWED_EMAILS=
# 프론트를 같은 도메인(Caddy)에서 열므로 CORS 는 필요 없다. 다른 도메인에서 부를 때만 넣는다
# CORS_ALLOWED_ORIGINS=https://example.com

# ---- AI agent ----
AGENT_MODE=upstage
UPSTAGE_API_KEY=
# UPSTAGE_PROJECT_ID=
# UPSTAGE_AGENT_ID=
# UPSTAGE_CONFIG_ID=

# ---- JVM (2GB 인스턴스 기준) ----
# JAVA_OPTS=-Xms256m -Xmx512m -XX:+ExitOnOutOfMemoryError

# ---- 체험하기(계정 없이 써 보기) ----
# 체험 점검도 실제 Upstage 를 부른다. false 면 체험 API 가 404
# DEMO_ENABLED=true
# DEMO_PER_USER_LIMIT=3
# DEMO_DAILY_LIMIT=50
# DEMO_MAX_CONCURRENT=2
# DEMO_TOKENS_PER_IP_HOUR=10
