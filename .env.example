# cp .env.example .env 후 값을 채운다. .env 는 저장소에 올리지 않는다.
# 백엔드(backend/)는 ../.env 를 읽고, compose.yaml 도 이 파일을 읽는다.

# ---- DB (compose.yaml 의 MySQL) ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=origin_check
DB_USERNAME=origin_check
DB_PASSWORD=origin_check
DB_ROOT_PASSWORD=root

# ---- 인증 ----
# 32자 이상 무작위 문자열. 예: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_MIN=60
CORS_ALLOWED_ORIGINS=http://localhost:5173
# 가입 허용 이메일(쉼표로 여러 개, '@acme.com' 은 도메인 전체). 비우면 누구나 가입(로컬 개발용)
# SIGNUP_ALLOWED_EMAILS=

# ---- AI agent ----
# upstage: Upstage 호출 / fake: AGENT_FAKE_RESULT 의 JSON 을 AGENT_FAKE_DELAY 뒤에 결과로 돌려줌
AGENT_MODE=upstage
# AGENT_FAKE_RESULT=src/test/resources/check_result_set04.json
# AGENT_FAKE_DELAY=10s
# AGENT_POLL_INTERVAL_MS=5000
# AGENT_TIMEOUT=30m
# AGENT_SUBMIT_MAX_ATTEMPTS=5
# AGENT_SUBMIT_RETRY_DELAY=10s

UPSTAGE_API_KEY=
# 기본값을 바꿀 때만
# UPSTAGE_PROJECT_ID=
# UPSTAGE_AGENT_ID=
# UPSTAGE_CONFIG_ID=

# ---- 파일 ----
# STORAGE_DIR=./data/uploads

# ---- 체험하기(계정 없이 써 보기) ----
# 체험 점검도 실제 Upstage 를 부른다. false 면 체험 API 가 404
# DEMO_ENABLED=true
# DEMO_PER_USER_LIMIT=3
# DEMO_DAILY_LIMIT=50
# DEMO_MAX_CONCURRENT=2
# DEMO_TOKENS_PER_IP_HOUR=10
